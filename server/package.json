{
  "name": "@wb/server",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --conditions=development src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --conditions=development --test tests/*.test.ts",
    "test:comparisons": "tsx --conditions=development --test tests/comparisons.test.ts",
    "test:assistant": "tsx --conditions=development --test tests/assistant.test.ts",
    "test:chaoxing": "tsx --conditions=development --test tests/chaoxing.test.ts",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/multipart": "^9.0.1",
    "@napi-rs/keyring": "2.1.2",
    "@wb/shared": "workspace:*",
    "better-sqlite3": "^12.11.1",
    "croner": "^9.0.0",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.12.7",
    "pdfjs-dist": "^4.10.38",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
