{
  "name": "yoshinove-workbench",
  "private": true,
  "version": "0.1.0",
  "description": "学生工作台：课表/提醒/学习通/健康跑/笔记/AI实验区",
  "scripts": {
    "dev": "node tools/setup-pet.mjs && concurrently -n server,client -c blue,green \"pnpm --filter @wb/server dev\" \"pnpm --filter @wb/client dev\"",
    "dev:server": "node tools/setup-pet.mjs && pnpm --filter @wb/server dev",
    "dev:client": "node tools/setup-pet.mjs && pnpm --filter @wb/client dev",
    "build": "node tools/setup-pet.mjs && pnpm -r build",
    "pet:prepare": "node tools/setup-pet.mjs",
    "typecheck": "pnpm -r typecheck",
    "test:comparison-export": "pnpm --filter @wb/server exec tsx --test ../client/tests/comparisonExport.test.ts"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "esbuild": "0.25.12",
    "fflate": "0.8.2"
  },
  "dependencies": {
    "@electron-internal/extract-zip": "1.0.5",
    "@electron/get": "5.1.0"
  }
}
